generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ON_LEAVE
}

model User {
  id               String       @id @default(cuid())
  name             String
  email            String       @unique
  phone            String?
  role             Role
  passwordHash     String
  status           AccountStatus @default(ACTIVE)
  locations        Location[]   @relation("ManagerLocations")
  attendanceMarked Attendance[] @relation("AttendanceMarker")
  auditLogs         AuditLog[]  @relation("AuditActor")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([role, status])
}

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String?
  guards    Guard[]
  managers  User[]   @relation("ManagerLocations")
  createdAt DateTime @default(now())
}

model Guard {
  id            String        @id @default(cuid())
  name          String
  employeeId    String        @unique
  phone         String
  email         String?
  address       String
  photoUrl      String?
  guardMonthlySalary   Decimal       @map("monthlySalary") @db.Decimal(12, 2)
  companyMonthlySalary Decimal       @default(0) @db.Decimal(12, 2)
  status        AccountStatus @default(ACTIVE)
  locationId    String
  location      Location      @relation(fields: [locationId], references: [id])
  attendance    Attendance[]
  salaryRecords SalaryRecord[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([locationId, status])
  @@index([name])
}

model Attendance {
  id         String           @id @default(cuid())
  guardId    String
  guard      Guard            @relation(fields: [guardId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  markedById String
  markedBy   User             @relation("AttendanceMarker", fields: [markedById], references: [id])
  markedAt   DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([guardId, date])
  @@index([date, status])
  @@index([markedById, date])
}

model SalaryRecord {
  id            String   @id @default(cuid())
  guardId       String
  guard         Guard    @relation(fields: [guardId], references: [id], onDelete: Cascade)
  monthYear     DateTime  @db.Date
  totalDays     Int
  leaveDays     Int
  guardDailyRate       Decimal  @map("dailyRate") @db.Decimal(12, 2)
  guardGrossSalary     Decimal  @map("grossSalary") @db.Decimal(12, 2)
  guardDeductions      Decimal  @map("deductions") @db.Decimal(12, 2)
  guardNetSalary       Decimal  @map("netSalary") @db.Decimal(12, 2)
  companyDailyRate     Decimal  @default(0) @db.Decimal(12, 2)
  companyGrossSalary   Decimal  @default(0) @db.Decimal(12, 2)
  companyDeductions    Decimal  @default(0) @db.Decimal(12, 2)
  companyNetSalary     Decimal  @default(0) @db.Decimal(12, 2)
  generatedAt   DateTime @default(now())

  @@unique([guardId, monthYear])
  @@index([monthYear])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
